diff --git a/apps/web/src/app/ticket/[code]/page.tsx b/apps/web/src/app/ticket/[code]/page.tsx
new file mode 100644
index 0000000..7a75196
--- /dev/null
+++ b/apps/web/src/app/ticket/[code]/page.tsx
@@ -0,0 +1,104 @@
+'use client'
+
+import { useEffect, useState } from 'react'
+import { useParams, useSearchParams } from 'next/navigation'
+import { Suspense } from 'react'
+import { api } from '@/lib/api'
+import { formatDate, formatTime, formatPrice } from '@bus/utils'
+import { Printer } from 'lucide-react'
+
+interface Ticket {
+  code: string
+  status: 'VALID' | 'VOIDED'
+  passengerName: string | null
+  seatNumbers: string[]
+  totalPrice: number
+  companyName: string
+  plateNumber: string
+  busType: string
+  fromCity: string
+  toCity: string
+  departureTime: string
+  arrivalTime: string
+  pickupPoint: { name: string; offsetMin: number } | null
+  dropoffPoint: { name: string } | null
+  qrCode: string
+}
+
+function TicketView() {
+  const { code } = useParams<{ code: string }>()
+  const search = useSearchParams()
+  const [ticket, setTicket] = useState<Ticket | null>(null)
+  const [error, setError] = useState('')
+
+  useEffect(() => {
+    api.get(`/tickets/${code}`)
+      .then((res) => setTicket(res.data.data.ticket))
+      .catch(() => setError('Ticket not found. Please check the code.'))
+  }, [code])
+
+  // Opened from the counter's Print button
+  useEffect(() => {
+    if (ticket && search.get('print') === '1') setTimeout(() => window.print(), 400)
+  }, [ticket, search])
+
+  if (error) return <p style={{ textAlign: 'center', padding: '80px 20px', color: '#999' }}>{error}</p>
+  if (!ticket) return <p style={{ textAlign: 'center', padding: '80px 20px', color: '#999' }}>Loading...</p>
+
+  const valid = ticket.status === 'VALID'
+  const row = (k: string, v: React.ReactNode) => (
+    <div style={{ display: 'flex', justifyContent: 'space-between', gap: '16px', padding: '10px 0', borderTop: '1px solid #F2F2F2', fontSize: '14px' }}>
+      <span style={{ color: '#999' }}>{k}</span>
+      <span style={{ fontWeight: 600, color: '#1a1a1a', textAlign: 'right' }}>{v}</span>
+    </div>
+  )
+
+  return (
+    <div style={{ maxWidth: '420px', margin: '0 auto', padding: '24px 16px' }}>
+      <div style={{ background: 'white', borderRadius: '20px', overflow: 'hidden', boxShadow: '0 4px 24px rgba(0,0,0,0.08)' }}>
+        <div style={{ background: valid ? '#1A0A0A' : '#7F1D1D', padding: '18px 20px', color: 'white' }}>
+          <div style={{ fontSize: '12px', color: '#D4A017' }}>{ticket.companyName}</div>
+          <div style={{ fontSize: '20px', fontWeight: 700, marginTop: '2px' }}>{ticket.fromCity} → {ticket.toCity}</div>
+          <div style={{ fontSize: '13px', opacity: 0.7, marginTop: '4px' }}>
+            {formatDate(ticket.departureTime)} · {formatTime(ticket.departureTime)}
+          </div>
+        </div>
+        {!valid && (
+          <div style={{ background: '#FEE2E2', color: '#991B1B', padding: '12px 20px', fontSize: '14px', fontWeight: 700, textAlign: 'center' }}>
+            THIS TICKET HAS BEEN CANCELLED. DO NOT ACCEPT IT.
+          </div>
+        )}
+        <div style={{ padding: '20px', textAlign: 'center' }}>
+          {/* eslint-disable-next-line @next/next/no-img-element */}
+          <img src={ticket.qrCode} alt="Ticket QR code" width={190} height={190} style={{ margin: '0 auto', opacity: valid ? 1 : 0.25 }} />
+          <div style={{ fontSize: '26px', fontWeight: 800, letterSpacing: '4px', margin: '6px 0 14px' }}>{ticket.code}</div>
+          <div style={{ textAlign: 'left' }}>
+            {row('Passenger', ticket.passengerName ?? '—')}
+            {row(ticket.seatNumbers.length > 1 ? 'Seats' : 'Seat', ticket.seatNumbers.join(', '))}
+            {ticket.pickupPoint && row('Pickup', `${ticket.pickupPoint.name} (~${formatTime(new Date(new Date(ticket.departureTime).getTime() + ticket.pickupPoint.offsetMin * 60000).toISOString())})`)}
+            {ticket.dropoffPoint && row('Drop-off', ticket.dropoffPoint.name)}
+            {row('Bus', `${ticket.plateNumber} · ${ticket.busType}`)}
+            {row('Arrives', formatTime(ticket.arrivalTime))}
+            {row('Paid', formatPrice(ticket.totalPrice))}
+          </div>
+          <p style={{ fontSize: '12px', color: '#999', marginTop: '14px' }}>Please be at your pickup point 10–15 minutes early.</p>
+        </div>
+      </div>
+      <button className="no-print" onClick={() => window.print()}
+        style={{ width: '100%', marginTop: '16px', display: 'flex', alignItems: 'center', justifyContent: 'center', gap: '8px', background: 'white', border: '1px solid #E5E5E5', borderRadius: '12px', padding: '14px', fontSize: '14px', fontWeight: 600, cursor: 'pointer' }}>
+        <Printer size={16} /> Print ticket
+      </button>
+      <style>{`@media print { .no-print { display: none !important; } body { background: white !important; } }`}</style>
+    </div>
+  )
+}
+
+export default function TicketPage() {
+  return (
+    <div style={{ minHeight: '100vh', background: '#F8F8F8' }}>
+      <Suspense fallback={<p style={{ textAlign: 'center', padding: '80px 20px', color: '#999' }}>Loading...</p>}>
+        <TicketView />
+      </Suspense>
+    </div>
+  )
+}
diff --git a/apps/web/src/components/CounterSalesList.tsx b/apps/web/src/components/CounterSalesList.tsx
new file mode 100644
index 0000000..b78892d
--- /dev/null
+++ b/apps/web/src/components/CounterSalesList.tsx
@@ -0,0 +1,73 @@
+'use client'
+
+import { formatDate, formatTime, formatPrice } from '@bus/utils'
+import { Ban } from 'lucide-react'
+import { CounterSale, METHOD_LABEL } from '@/lib/counter'
+
+/** A list of counter sales, with a Void button where the person is allowed to void. */
+export default function CounterSalesList({
+  sales, onVoid, showSeller = false,
+}: {
+  sales: CounterSale[]
+  onVoid: (sale: CounterSale) => void
+  showSeller?: boolean
+}) {
+  if (sales.length === 0) {
+    return <p style={{ color: '#999', fontSize: '14px', padding: '24px 0', textAlign: 'center' }}>No sales on this day.</p>
+  }
+  return (
+    <div style={{ display: 'flex', flexDirection: 'column', gap: '10px' }}>
+      {sales.map((s) => {
+        const voided = s.status === 'CANCELLED'
+        return (
+          <div key={s.id} style={{ background: 'white', border: '1px solid #EEEEEE', borderRadius: '14px', padding: '14px 16px', opacity: voided ? 0.6 : 1 }}>
+            <div style={{ display: 'flex', justifyContent: 'space-between', gap: '12px', alignItems: 'flex-start' }}>
+              <div style={{ minWidth: 0 }}>
+                <div style={{ fontSize: '14px', fontWeight: 700, color: '#1a1a1a' }}>
+                  {s.passengerName} <span style={{ fontWeight: 400, color: '#999', fontSize: '12px' }}>{s.passengerPhone}</span>
+                </div>
+                <div style={{ fontSize: '12px', color: '#666', marginTop: '3px' }}>
+                  {s.schedule.route.fromCity} → {s.schedule.route.toCity} · {formatDate(s.schedule.departureTime)} {formatTime(s.schedule.departureTime)}
+                </div>
+                <div style={{ fontSize: '12px', color: '#666', marginTop: '2px' }}>
+                  Seat{s.seatNumbers.length > 1 ? 's' : ''} {s.seatNumbers.join(', ')}
+                  {s.pickupPoint ? ` · Pickup: ${s.pickupPoint.name}` : ''}
+                </div>
+                <div style={{ fontSize: '11px', color: '#999', marginTop: '4px' }}>
+                  {formatTime(s.createdAt)} · {METHOD_LABEL[s.payment?.method ?? ''] ?? '—'}
+                  {s.payment?.reference ? ` · ${s.payment.reference}` : s.payment?.method !== 'CASH' && voided ? ' · receipt released' : ''}
+                  {showSeller && s.soldByStaff ? ` · sold by ${s.soldByStaff.user.name}` : ''}
+                  {s.ticketCode ? ` · ${s.ticketCode}` : ''}
+                </div>
+                {voided && (
+                  <div style={{ fontSize: '12px', color: '#C0392B', marginTop: '6px' }}>
+                    Voided{s.voidedByStaff ? ` by ${s.voidedByStaff.user.name}` : ''}{s.voidReason ? `: ${s.voidReason}` : ''}
+                  </div>
+                )}
+              </div>
+              <div style={{ textAlign: 'right', flexShrink: 0 }}>
+                <div style={{ fontSize: '15px', fontWeight: 700, color: voided ? '#999' : '#C0392B', textDecoration: voided ? 'line-through' : 'none' }}>
+                  {formatPrice(s.totalPrice)}
+                </div>
+                <div style={{ display: 'flex', gap: '6px', marginTop: '8px', justifyContent: 'flex-end', flexWrap: 'wrap' }}>
+                  {s.ticketCode && !voided && (
+                    <a href={`/ticket/${s.ticketCode}`} target="_blank" rel="noreferrer"
+                       style={{ fontSize: '12px', fontWeight: 600, color: '#555', background: '#F5F5F5', padding: '6px 10px', borderRadius: '8px', textDecoration: 'none' }}>
+                      Ticket
+                    </a>
+                  )}
+                  {s.canVoid && (
+                    <button onClick={() => onVoid(s)}
+                      style={{ display: 'inline-flex', alignItems: 'center', gap: '4px', fontSize: '12px', fontWeight: 600, color: '#C0392B', background: '#FFF5F5', border: 'none', padding: '6px 10px', borderRadius: '8px', cursor: 'pointer' }}>
+                      <Ban size={12} /> Void
+                    </button>
+                  )}
+                </div>
+              </div>
+            </div>
+          </div>
+        )
+      })}
+    </div>
+  )
+}
diff --git a/apps/web/src/lib/counter.ts b/apps/web/src/lib/counter.ts
new file mode 100644
index 0000000..df727e6
--- /dev/null
+++ b/apps/web/src/lib/counter.ts
@@ -0,0 +1,37 @@
+// Shared by the counter screens (seller, manager report, public ticket).
+
+export const METHOD_LABEL: Record<string, string> = {
+  CASH: 'Cash',
+  TELEBIRR: 'Telebirr',
+  CBE_BIRR: 'CBE Birr',
+  BANK_TRANSFER: 'Bank transfer',
+  CARD: 'Card',
+}
+
+/** The Addis Ababa calendar day (YYYY-MM-DD) of a moment, or of now. */
+export const addisDay = (when: Date | string = new Date()) =>
+  new Date(when).toLocaleDateString('en-CA', { timeZone: 'Africa/Addis_Ababa' })
+
+export const errorOf = (err: unknown, fallback: string) =>
+  (err as { response?: { data?: { error?: string } } })?.response?.data?.error || fallback
+
+export interface CounterSale {
+  id: string
+  status: string
+  seatNumbers: string[]
+  totalPrice: number
+  passengerName: string | null
+  passengerPhone: string | null
+  ticketCode: string | null
+  createdAt: string
+  voidedAt: string | null
+  voidReason: string | null
+  canVoid: boolean
+  qrCode?: string
+  schedule: { departureTime: string; arrivalTime: string; route: { fromCity: string; toCity: string }; bus: { plateNumber: string } }
+  pickupPoint: { name: string; offsetMin: number } | null
+  dropoffPoint: { name: string } | null
+  payment: { method: string; reference: string | null; amount: number } | null
+  soldByStaff: { id: string; user: { name: string } } | null
+  voidedByStaff: { user: { name: string } } | null
+}
