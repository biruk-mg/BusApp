generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?  @unique
  password  String
  role      Role     @default(CUSTOMER)
  bookings  Booking[]
  staff     OperatorStaff?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Operator {
  id          String  @id @default(cuid())
  companyName String
  licenseNo   String  @unique
  phone       String
  buses       Bus[]
  pickupPoints PickupPoint[]
  staff       OperatorStaff[]

  // Managed by the platform admin
  status          OperatorStatus @default(ACTIVE)
  suspendedAt     DateTime?
  suspendedReason String?
  // Demo / test company: hidden from passengers, no online bookings
  isDemo          Boolean        @default(false)
  // Share of ONLINE sales kept by the platform, in percent (5 = 5%).
  // Counter sales carry no commission. Set to 0 for a pilot operator.
  commissionPercent Float        @default(5)
  notes           String?
  payouts         Payout[]

  createdAt   DateTime @default(now())
}

enum OperatorStatus {
  ACTIVE
  SUSPENDED
}

model Bus {
  id          String     @id @default(cuid())
  operatorId  String
  operator    Operator   @relation(fields: [operatorId], references: [id])
  plateNumber String     @unique
  totalSeats  Int
  busType     BusType    @default(STANDARD)
  schedules   Schedule[]
  templates   ScheduleTemplate[]
  createdAt   DateTime   @default(now())
}

model Route {
  id                  String     @id @default(cuid())
  fromCity            String
  toCity              String
  distanceKm          Float
  estimatedDurationMin Int
  schedules           Schedule[]
  templates           ScheduleTemplate[]
  pickupPoints        PickupPoint[]
  createdAt           DateTime   @default(now())

  @@unique([fromCity, toCity])
}

model Schedule {
  id            String    @id @default(cuid())
  routeId       String
  route         Route     @relation(fields: [routeId], references: [id])
  busId         String
  bus           Bus       @relation(fields: [busId], references: [id])
  departureTime DateTime
  arrivalTime   DateTime
  price         Float
  status        ScheduleStatus @default(OPEN)
  templateId    String?
  template      ScheduleTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  bookings      Booking[]
  createdAt     DateTime  @default(now())

  // A recurring schedule can never create the same departure twice.
  // Manual trips have no template (NULL), so they are not affected.
  @@unique([templateId, departureTime])
  @@index([departureTime])
}

enum ScheduleStatus {
  OPEN
  CLOSED
}

// A recurring daily schedule. Real Schedule rows are generated from it
// for the next 30 days. departureTime is the local Addis Ababa time ("05:00").
// daysOfWeek: 0 = Sunday ... 6 = Saturday.
model ScheduleTemplate {
  id            String     @id @default(cuid())
  busId         String
  bus           Bus        @relation(fields: [busId], references: [id])
  routeId       String
  route         Route      @relation(fields: [routeId], references: [id])
  departureTime String
  price         Float
  daysOfWeek    Int[]
  active        Boolean    @default(true)
  schedules     Schedule[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([busId])
}

model Booking {
  id          String        @id @default(cuid())
  // Online bookings belong to an account. Counter (walk-in) sales may have no
  // account: then the passenger is identified by passengerName / passengerPhone.
  userId      String?
  user        User?         @relation(fields: [userId], references: [id])
  scheduleId  String
  schedule    Schedule      @relation(fields: [scheduleId], references: [id])
  seatNumbers String[]
  totalPrice  Float
  status      BookingStatus @default(PENDING)
  qrCode      String        @unique
  payment     Payment?
  expiresAt   DateTime?
  pickupPointId  String?
  pickupPoint    PickupPoint? @relation("BookingPickup", fields: [pickupPointId], references: [id], onDelete: Restrict)
  dropoffPointId String?
  dropoffPoint   PickupPoint? @relation("BookingDropoff", fields: [dropoffPointId], references: [id], onDelete: Restrict)

  // Counter sales (made by staff at the bus station)
  source         BookingSource @default(ONLINE)
  passengerName  String?
  passengerPhone String?
  ticketCode     String?       @unique
  soldByStaffId  String?
  soldByStaff    OperatorStaff? @relation("StaffSales", fields: [soldByStaffId], references: [id], onDelete: Restrict)
  // A voided counter sale is CANCELLED with these set (who, when, why)
  voidedAt        DateTime?
  voidedByStaffId String?
  voidedByStaff   OperatorStaff? @relation("StaffVoids", fields: [voidedByStaffId], references: [id], onDelete: Restrict)
  voidReason      String?

  // The platform's share of this ONLINE booking, frozen when the payment was
  // confirmed, so changing a company's commission later never rewrites past
  // sales. Null = not frozen (older bookings): the company's current rate is used.
  commissionPercent Float?

  // Boarding (set by the ticket checker when the passenger gets on the bus)
  boardedAt        DateTime?
  boardedByStaffId String?
  boardedByStaff   OperatorStaff? @relation("StaffBoardings", fields: [boardedByStaffId], references: [id], onDelete: Restrict)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([soldByStaffId, createdAt])
}

enum BookingSource {
  ONLINE
  COUNTER
}

model Payment {
  id        String        @id @default(cuid())
  bookingId String        @unique
  booking   Booking       @relation(fields: [bookingId], references: [id])
  amount    Float
  method    PaymentMethod
  chapaRef  String?
  // Receipt / transaction number typed by the seller for Telebirr, CBE Birr and
  // bank transfers (empty for cash). The same number can't be used twice for
  // the same method, so one receipt can't pay for two tickets.
  reference String?
  // When a counter sale is voided its reference moves here, so the passenger's
  // real receipt can be used again for the corrected sale.
  voidedReference String?
  status    PaymentStatus @default(PENDING)

  // Refund bookkeeping for online payments. The money itself is sent back by the
  // admin (Chapa, Telebirr...); this records that it was done, so the booking
  // leaves the "refund needed" list and the company's earnings.
  refundedAt       DateTime?
  refundedByUserId String?
  refundReference  String?
  refundNote       String?

  createdAt DateTime      @default(now())

  @@unique([method, reference])
}

enum Role {
  CUSTOMER
  OPERATOR
  DRIVER
  ADMIN
}

enum BusType {
  STANDARD
  LUXURY
  MINIBUS
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  CASH
  TELEBIRR
  CBE_BIRR
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PickupKind {
  PICKUP
  DROPOFF
  BOTH
}

// Where passengers board (or get off) along a route, for one operator.
// offsetMin = minutes after the trip's departure from the main station.
model PickupPoint {
  id         String     @id @default(cuid())
  operatorId String
  operator   Operator   @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  routeId    String
  route      Route      @relation(fields: [routeId], references: [id], onDelete: Cascade)
  name       String
  kind       PickupKind @default(PICKUP)
  sequence   Int        @default(0)
  offsetMin  Int        @default(0)
  createdAt  DateTime   @default(now())

  pickupBookings  Booking[] @relation("BookingPickup")
  dropoffBookings Booking[] @relation("BookingDropoff")

  @@unique([operatorId, routeId, name])
  @@index([operatorId, routeId])
}


enum StaffRole {
  MANAGER
  SELLER
  CHECKER
}

// Who works for which operator company, and in which role.
// This is the single source of truth for "what may this person do":
// the API reads it on every request (never from the login token), so
// deactivating someone takes effect immediately.
// One person works for one company (userId is unique).
model OperatorStaff {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  operatorId String
  operator   Operator  @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  role       StaffRole
  active     Boolean   @default(true)
  sales      Booking[] @relation("StaffSales")
  voids      Booking[] @relation("StaffVoids")
  boardings  Booking[] @relation("StaffBoardings")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([operatorId])
}

enum PayoutMethod {
  TELEBIRR
  CBE_BIRR
  BANK_TRANSFER
  CASH
}

// Money the platform has paid out to an operator company (their share of the
// ONLINE sales that Chapa settled to the platform). Never deleted: a mistake is
// voided with a reason, so the history stays complete.
model Payout {
  id              String       @id @default(cuid())
  operatorId      String
  operator        Operator     @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  amount          Float
  method          PayoutMethod
  // The receipt / transaction number of the transfer. The same receipt can't be
  // recorded twice for the same method.
  reference       String?
  // A voided payout's receipt moves here, so the correct entry can reuse it.
  voidedReference String?
  note            String?
  paidAt          DateTime     @default(now())
  createdByUserId String
  voidedAt        DateTime?
  voidReason      String?
  voidedByUserId  String?
  createdAt       DateTime     @default(now())

  @@unique([method, reference])
  @@index([operatorId, paidAt])
}

// An announcement shown on the home page (deals and offers). Managed by the
// platform admin. It is only shown while active and inside its dates.
model Banner {
  id        String    @id @default(cuid())
  title     String
  message   String    @default("")
  badge     String?
  linkText  String?
  linkUrl   String?
  theme     String    @default("red")
  // A designed image replaces the text card. The wide image is required for an
  // image banner; the phone image is optional (the wide one is used without it).
  // They are stored here (JPEG, PNG or WebP, max 1 MB) and served by the API.
  // imageVersion goes up on every change, so browsers never show an old picture.
  altText         String?
  imageData       Bytes?
  imageMime       String?
  mobileImageData Bytes?
  mobileImageMime String?
  imageVersion    Int       @default(0)
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
