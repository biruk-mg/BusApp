generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?  @unique
  password  String
  role      Role     @default(CUSTOMER)
  bookings  Booking[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Operator {
  id          String  @id @default(cuid())
  companyName String
  licenseNo   String  @unique
  phone       String
  buses       Bus[]
  pickupPoints PickupPoint[]
  createdAt   DateTime @default(now())
}

model Bus {
  id          String     @id @default(cuid())
  operatorId  String
  operator    Operator   @relation(fields: [operatorId], references: [id])
  plateNumber String     @unique
  totalSeats  Int
  busType     BusType    @default(STANDARD)
  schedules   Schedule[]
  templates   ScheduleTemplate[]
  createdAt   DateTime   @default(now())
}

model Route {
  id                  String     @id @default(cuid())
  fromCity            String
  toCity              String
  distanceKm          Float
  estimatedDurationMin Int
  schedules           Schedule[]
  templates           ScheduleTemplate[]
  pickupPoints        PickupPoint[]
  createdAt           DateTime   @default(now())

  @@unique([fromCity, toCity])
}

model Schedule {
  id            String    @id @default(cuid())
  routeId       String
  route         Route     @relation(fields: [routeId], references: [id])
  busId         String
  bus           Bus       @relation(fields: [busId], references: [id])
  departureTime DateTime
  arrivalTime   DateTime
  price         Float
  status        ScheduleStatus @default(OPEN)
  templateId    String?
  template      ScheduleTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  bookings      Booking[]
  createdAt     DateTime  @default(now())

  // A recurring schedule can never create the same departure twice.
  // Manual trips have no template (NULL), so they are not affected.
  @@unique([templateId, departureTime])
  @@index([departureTime])
}

enum ScheduleStatus {
  OPEN
  CLOSED
}

// A recurring daily schedule. Real Schedule rows are generated from it
// for the next 30 days. departureTime is the local Addis Ababa time ("05:00").
// daysOfWeek: 0 = Sunday ... 6 = Saturday.
model ScheduleTemplate {
  id            String     @id @default(cuid())
  busId         String
  bus           Bus        @relation(fields: [busId], references: [id])
  routeId       String
  route         Route      @relation(fields: [routeId], references: [id])
  departureTime String
  price         Float
  daysOfWeek    Int[]
  active        Boolean    @default(true)
  schedules     Schedule[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([busId])
}

model Booking {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  scheduleId  String
  schedule    Schedule      @relation(fields: [scheduleId], references: [id])
  seatNumbers String[]
  totalPrice  Float
  status      BookingStatus @default(PENDING)
  qrCode      String        @unique
  payment     Payment?
  expiresAt   DateTime?
  pickupPointId  String?
  pickupPoint    PickupPoint? @relation("BookingPickup", fields: [pickupPointId], references: [id], onDelete: Restrict)
  dropoffPointId String?
  dropoffPoint   PickupPoint? @relation("BookingDropoff", fields: [dropoffPointId], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Payment {
  id        String        @id @default(cuid())
  bookingId String        @unique
  booking   Booking       @relation(fields: [bookingId], references: [id])
  amount    Float
  method    PaymentMethod
  chapaRef  String?
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())
}

enum Role {
  CUSTOMER
  OPERATOR
  DRIVER
  ADMIN
}

enum BusType {
  STANDARD
  LUXURY
  MINIBUS
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  TELEBIRR
  CBE_BIRR
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PickupKind {
  PICKUP
  DROPOFF
  BOTH
}

// Where passengers board (or get off) along a route, for one operator.
// offsetMin = minutes after the trip's departure from the main station.
model PickupPoint {
  id         String     @id @default(cuid())
  operatorId String
  operator   Operator   @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  routeId    String
  route      Route      @relation(fields: [routeId], references: [id], onDelete: Cascade)
  name       String
  kind       PickupKind @default(PICKUP)
  sequence   Int        @default(0)
  offsetMin  Int        @default(0)
  createdAt  DateTime   @default(now())

  pickupBookings  Booking[] @relation("BookingPickup")
  dropoffBookings Booking[] @relation("BookingDropoff")

  @@unique([operatorId, routeId, name])
  @@index([operatorId, routeId])
}
